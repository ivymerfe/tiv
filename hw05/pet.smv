MODULE main
VAR
  pc0 : 0..4;
  pc1 : 0..4;
  flag0 : boolean;
  flag1 : boolean;
  turn : 0..1;
  sel : 0..1;
DEFINE
  want0 := pc0 != 0;
  want1 := pc1 != 0;
  cs0 := pc0 = 4;
  cs1 := pc1 = 4;
ASSIGN
  init(pc0) := 0;
  init(pc1) := 0;
  init(flag0) := FALSE;
  init(flag1) := FALSE;
  init(turn) := 0;
  next(pc0) := case
    sel != 0 : pc0;
    pc0 = 3 & flag1 & turn != 0 : 3;
    pc0 = 4 : 0;
    TRUE : pc0 + 1;
  esac;
  next(pc1) := case
    sel != 1 : pc1;
    pc1 = 3 & flag0 & turn != 1 : 3;
    pc1 = 4 : 0;
    TRUE : pc1 + 1;
  esac;
  next(flag0) := case
    sel = 0 & pc0 = 1 : TRUE;
    sel = 0 & pc0 = 4 : FALSE;
    TRUE : flag0;
  esac;
  next(flag1) := case
    sel = 1 & pc1 = 1 : TRUE;
    sel = 1 & pc1 = 4 : FALSE;
    TRUE : flag1;
  esac;
  next(turn) := case
    sel = 0 & pc0 = 2 : 1;
    sel = 1 & pc1 = 2 : 0;
    TRUE : turn;
  esac;

FAIRNESS sel = 0
FAIRNESS sel = 1

SPEC AG !(cs0 & cs1)
LTLSPEC G !(cs0 & cs1)
LTLSPEC G (cs0 -> flag0)
LTLSPEC G ((cs0 & pc1 = 3) -> turn = 0)
LTLSPEC G (want0 -> F cs0)
LTLSPEC G (want1 -> F cs1)
SPEC AG (want0 -> AF cs0)
SPEC AG EF cs0
SPEC EF cs0
SPEC EF (cs0 & cs1)
