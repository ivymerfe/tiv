opt(a: int, b: int)
  returns r: int
  uses x: int, y: int, t: int, u: int
{
  x = 4 * 5 + 2;
  y = x - 22;
  t = a * 1 + 0;
  u = b * 7 + a;
  if (x > 10) {
    y = 3 * 0 + 8 / 2 - 4;
    r = (a + b) * (a + b) + t;
    r = r + y * a;
  } else
    r = u;
  

  while (x < -100) {
    x = x - 1;
  }
  r = r + a * 2;
  r = 0;
}
